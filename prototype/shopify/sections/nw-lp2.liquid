      "sachet": {{ 'nw-lp2-sobre-watermelon.webp' | asset_url | json }},
      "gallery": [
        {"src": {{ 'nw-lp2-g-watermelon-0-comp.webp' | asset_url | json }}, "thumb": {{ 'nw-lp2-g-watermelon-0-comp-t.webp' | asset_url | json }}, "alt": "Caja y sobre de LIT Salty Watermelon"}
        {%- comment -%} La 1.ª foto del producto muestra el sobre anterior (1000 mg de sodio): se salta {%- endcomment -%}
        {%- for img in p_w.images offset: 1 limit: 6 -%}
          ,{"src": {{ img | image_url: width: 1000 | json }}, "thumb": {{ img | image_url: width: 260 | json }}, "alt": {{ lp2_alts[forloop.index0] | replace: '{n}', 'Salty Watermelon' | json }}}
        {%- endfor %}
      ]
    },
    "peach": {
      "name": "Salty Peach", "short": "Peach", "color": "var(--peach)", "aroma": "melocotón",
      "sub": {{ lp2_v_sp.id | json }}, "ot": {{ lp2_v_op.id | json }},
      "sachet": {{ 'nw-lp2-sobre-peach.webp' | asset_url | json }},
      "gallery": [
        {"src": {{ 'nw-lp2-g-peach-0-comp.webp' | asset_url | json }}, "thumb": {{ 'nw-lp2-g-peach-0-comp-t.webp' | asset_url | json }}, "alt": "Caja y sobre de LIT Salty Peach"}
        {%- comment -%} La 1.ª foto del producto muestra el sobre anterior (1000 mg de sodio): se salta {%- endcomment -%}
        {%- for img in p_p.images offset: 1 limit: 6 -%}
          ,{"src": {{ img | image_url: width: 1000 | json }}, "thumb": {{ img | image_url: width: 260 | json }}, "alt": {{ lp2_alts[forloop.index0] | replace: '{n}', 'Salty Peach' | json }}}
        {%- endfor %}
      ]
    }
  },
  "pack": {
    "sub": {
      {%- for v in k_s.variants -%}
        {%- liquid
          assign nl = 0
          assign nw = 0
          assign np = 0
          assign parts = v.title | split: ' + '
          for part in parts
            assign n = part | split: ' ' | first | plus: 0
            if part contains 'Watermelon'
              assign nw = n
            elsif part contains 'Peach'
              assign np = n
            elsif part contains 'Lemon'
              assign nl = n
            endif
          endfor
        -%}
        "{{ nl }}-{{ nw }}-{{ np }}": {{ v.id | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor %}
    },
    "ot": {
      {%- for v in k_o.variants -%}
        {%- liquid
          assign nl = 0
          assign nw = 0
          assign np = 0
          assign parts = v.title | split: ' + '
          for part in parts
            assign n = part | split: ' ' | first | plus: 0
            if part contains 'Watermelon'
              assign nw = n
            elsif part contains 'Peach'
              assign np = n
            elsif part contains 'Lemon'
              assign nl = n
            endif
          endfor
        -%}
        "{{ nl }}-{{ nw }}-{{ np }}": {{ v.id | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor %}
    }
  },
  "prices": {"1": {"sub": {"now": {{ lp2_sub1_now }}, "was": {{ lp2_sub1_was }}}, "ot": {"now": {{ lp2_ot1_now }}}}, "4": {"sub": {"now": {{ lp2_sub4_now }}, "was": {{ lp2_sub4_was }}}, "ot": {"now": {{ lp2_ot4_now }}}}},
  "units": {"1": 30, "4": 120},
  "maxQty": 10
}
</script>

